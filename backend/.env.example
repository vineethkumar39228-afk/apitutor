# Production Environment Variables Template
PORT=5000
NODE_ENV=production

# Database & Caching Connections
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/apitutor?retryWrites=true&w=majority
REDIS_URL=redis://redis:6379

# Authentication Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_production_jwt_secret_here_change_me
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_here_change_me

# External Services
GEMINI_API_KEY=your_google_gemini_api_key_here
